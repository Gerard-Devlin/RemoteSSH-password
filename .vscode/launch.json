{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (English)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--user-data-dir=${workspaceFolder}/.test-host/debug-en/user-data",
        "--extensions-dir=${workspaceFolder}/.test-host/debug-en/extensions",
        "--locale=en"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Run Extension (Simplified Chinese)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--user-data-dir=${workspaceFolder}/.test-host/debug-zh-cn/user-data",
        "--extensions-dir=${workspaceFolder}/.test-host/debug-zh-cn/extensions",
        "--locale=zh-cn"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ]
}
