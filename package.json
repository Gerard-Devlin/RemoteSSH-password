{
  "name": "remote-ssh-password-memory",
  "displayName": "Remote SSH Password Memory",
  "description": "%extension.description%",
  "version": "1.2.0",
  "publisher": "Devlin",
  "license": "MIT",
  "engines": {
    "vscode": "^1.73.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "extensionDependencies": [
    "ms-vscode-remote.remote-ssh"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onResolveRemoteAuthority:ssh-remote"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "sshPasswordMemory.enable",
        "title": "%command.enable%",
        "category": "%command.category%"
      },
      {
        "command": "sshPasswordMemory.disable",
        "title": "%command.disable%",
        "category": "%command.category%"
      },
      {
        "command": "sshPasswordMemory.manage",
        "title": "%command.manage%",
        "category": "%command.category%"
      },
      {
        "command": "sshPasswordMemory.forget",
        "title": "%command.forget%",
        "category": "%command.category%"
      },
      {
        "command": "sshPasswordMemory.diagnostics",
        "title": "%command.diagnostics%",
        "category": "%command.category%"
      }
    ]
  },
  "scripts": {
    "generate:compatibility": "node scripts/generate-compatibility.mjs",
    "compile": "node scripts/generate-compatibility.mjs --check && tsc -p . && node scripts/build-uninstall.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build": "npm run compile && npm run build:native",
    "test:ts": "node --test dist/test/*.test.js",
    "test:native": "cd native && go test ./...",
    "test": "npm run compile && npm run test:ts && npm run test:localization && npm run test:docs && npm run test:native",
    "package": "npm run compile && node scripts/package.mjs",
    "test:integration": "npm run build && npm run build:fixture && node scripts/integration.mjs",
    "test:race": "cd native && go test -race ./...",
    "build:fixture": "node scripts/build-fixture.mjs",
    "test:host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/host-tests.ps1",
    "format": "prettier --write . && cd native && go fmt ./... && cd testserver && go fmt ./...",
    "test:extension": "npm run build && npm run build:fixture && node scripts/extension-tests.mjs en && node scripts/extension-tests.mjs zh-cn",
    "test:localization": "node --test scripts/localization.test.mjs",
    "test:docs": "node --test scripts/docs.test.mjs",
    "test:windows-builds": "node scripts/windows-openssh-builds.mjs",
    "test:vscode-compat": "npm run build && node scripts/vscode-compat.test.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "format:check": "prettier --check .",
    "check": "npm run generate:compatibility -- --check && npm run format:check && npm test",
    "version:major": "node scripts/bump-version.mjs major",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "package:all": "npm run compile && node scripts/package-all.mjs",
    "vscode:uninstall": "node ./dist/uninstall.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.73.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "yauzl": "^3.4.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "l10n": "./l10n",
  "keywords": [
    "ssh",
    "remote-ssh",
    "password",
    "windows",
    "secretstorage",
    "macos"
  ],
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gerard-Devlin/RemoteSSH-password.git"
  },
  "homepage": "https://github.com/Gerard-Devlin/RemoteSSH-password#readme",
  "bugs": {
    "url": "https://github.com/Gerard-Devlin/RemoteSSH-password/issues"
  }
}
